DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tanktelemetry?schema=public
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

INCIDENT_MONITOR_ENABLED=true
ALERT_ERROR_RATE_THRESHOLD=0.05
ALERT_P95_LATENCY_MS=2000
ALERT_WINDOW_MINUTES=5
ALERT_MIN_SAMPLE_SIZE=20
ALERT_COOLDOWN_MS=300000
ALERT_CRON=*/1 * * * *
ALERTS_ENABLED=true
RESEND_API_KEY=
RESEND_FROM_EMAIL=alerts@yourdomain.com
ALERT_EMAIL_TO=oncall@yourdomain.com
